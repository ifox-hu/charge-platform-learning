.hero { background: #173428; border-radius: 16rpx; padding: 30rpx; color: #fff; overflow: hidden; }
.hero-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 38rpx; }
.brand-mark { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; background: #b8ff5e; color: #18321f; font-size: 42rpx; font-weight: 800; }
.account { display: flex; align-items: center; gap: 8rpx; color: #d8e5df; font-size: 24rpx; padding: 10rpx 0 10rpx 20rpx; }
.account-arrow { color: #b8ff5e; font-size: 38rpx; line-height: 1; }
.eyebrow { color: #b8ff5e; font-size: 20rpx; font-weight: 700; letter-spacing: 3rpx; }
.hero-title { font-size: 44rpx; font-weight: 700; margin-top: 14rpx; }
.hero-copy { color: #bed0c7; font-size: 25rpx; margin-top: 14rpx; line-height: 1.6; }
.hero-stats { display: flex; align-items: center; gap: 30rpx; margin-top: 34rpx; padding-top: 26rpx; border-top: 1rpx solid #35604c; }
.hero-stats > view:not(.stat-divider) { display: flex; align-items: baseline; gap: 12rpx; }
.stat-value { font-size: 40rpx; font-weight: 700; }
.stat-value.accent { color: #b8ff5e; }
.stat-label { color: #9eb2aa; font-size: 22rpx; }
.stat-divider { width: 1rpx; height: 34rpx; background: #456b59; }
.section-head { display: flex; justify-content: space-between; align-items: flex-end; margin: 36rpx 4rpx 18rpx; }
.section-kicker { display: block; color: #69a83c; font-size: 18rpx; font-weight: 700; letter-spacing: 3rpx; margin-bottom: 6rpx; }
.section-title { display: block; font-size: 32rpx; font-weight: 700; }
.section-count { color: #7d8c85; font-size: 23rpx; }
.station { display: grid; grid-template-columns: 76rpx minmax(0, 1fr) 24rpx; gap: 20rpx; align-items: center; }
.station-icon { width: 72rpx; height: 72rpx; display: flex; justify-content: center; align-items: center; border-radius: 14rpx; background: #e9f9df; color: #4b872f; font-size: 38rpx; }
.station-content { min-width: 0; }
.station-head { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; margin-bottom: 10rpx; }
.station-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 30rpx; font-weight: 700; }
.status { flex: none; font-size: 20rpx; font-weight: 700; padding: 6rpx 12rpx; border-radius: 20rpx; }
.status.online { color: #3d7735; background: #e8f4e5; }
.status.closed { color: #9a4844; background: #f3e8e7; }
.address { color: #7d8c85; font-size: 23rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.address-dot { display: inline-block; width: 8rpx; height: 8rpx; margin-right: 10rpx; border-radius: 50%; background: #69a83c; vertical-align: middle; }
.description { margin-top: 10rpx; color: #526159; font-size: 24rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.enter { color: #69a83c; font-size: 42rpx; line-height: 1; }
.map-card { margin: 26rpx 0 10rpx; padding: 24rpx; background: #fff; border: 1rpx solid #e0e7e2; border-radius: 16rpx; box-shadow: 0 8rpx 28rpx rgba(26,57,43,.04); }
.map-card-head { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 16rpx; }
.map-location-label { color: #69a83c; font-size: 22rpx; }
.map-location-actions { display: flex; align-items: center; gap: 14rpx; }
.locate-button { color: #3d8135; font-size: 21rpx; font-weight: 700; padding: 7rpx 12rpx; border: 1rpx solid #b8dba8; border-radius: 18rpx; }
.station-map { width: 100%; height: 360rpx; border-radius: 12rpx; overflow: hidden; }
