<view class="page">
  <view class="login-brand"><view class="brand-mark">ϟ</view><view class="eyebrow">CHARGE NETWORK</view></view>
  <view class="card form">
    <view class="title">登录充电平台</view>
    <view class="subtitle">进入运营端，查看站点和设备状态</view>
    <input class="input" value="{{username}}" placeholder="用户名" bindinput="onUsernameInput" />
    <input class="input" value="{{password}}" password placeholder="密码" bindinput="onPasswordInput" />
    <button class="primary" loading="{{loading}}" bindtap="submit">登录</button>
    <view class="muted hint">当前使用运营人员测试账号，可在输入框中修改。</view>
  </view>
</view>
