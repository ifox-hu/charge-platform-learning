<view class="page">
  <view wx:if="{{loading}}" class="empty">正在加载站点详情...</view>
  <view wx:elif="{{error}}" class="error">{{error}}</view>
  <block wx:else>
    <view class="station-hero" wx:if="{{station}}">
      <view class="back-mark" bindtap="goBack">‹</view>
      <view class="eyebrow">STATION DETAIL</view>
      <view class="title">{{station.name}}</view>
      <view class="address"><text class="address-dot"></text>{{station.address || '暂无地址'}}</view>
      <view class="station-status">{{station.status === 'OPERATING' ? '运营中' : station.status}}</view>
      <view class="station-summary"><view><text>{{chargerCount}}</text><label>充电桩</label></view><view><text>{{connectorCount}}</text><label>充电枪</label></view></view>
    </view>
    <view class="price-card">
      <view class="price-head"><view><text class="section-kicker">PRICING</text><text class="price-title">分时计费标准</text></view><text class="price-unit">元 / kWh</text></view>
      <view wx:if="{{!prices.length}}" class="price-empty">暂未配置电价</view>
      <view wx:for="{{prices}}" wx:key="id" class="price-row"><text>{{item.startTime}} - {{item.endTime}}</text><text><text class="price-number">{{item.electricityPrice}}</text> 电费 + {{item.servicePrice}} 服务费</text></view>
    </view>
    <view class="section-head"><view><text class="section-kicker">DEVICES</text><text class="section-title">充电设备</text></view><text class="section-count">实时状态</text></view>
    <view wx:if="{{!chargers.length}}" class="empty">暂无充电桩</view>
    <view wx:for="{{chargers}}" wx:for-item="charger" wx:key="id" class="card charger" data-id="{{charger.id}}" data-device="{{charger.simulatorDeviceId}}" bindtap="openCharger">
      <view class="charger-head"><view><text class="charger-code">{{charger.code}}</text><text class="charger-title">{{charger.name || charger.code}}</text></view><text class="charger-status">{{charger.statusText}}</text></view>
      <view class="charger-foot"><text>{{charger.connectors.length}} 把充电枪</text><text class="enter">进入操作 ›</text></view>
    </view>
  </block>
</view>
